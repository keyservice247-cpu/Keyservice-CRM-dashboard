# Adres van je dashboard (zonder slash op het eind)
DASHBOARD_URL=https://keyservice-crm.onrender.com

# Het INGEST_TOKEN dat ook in je dashboard (Render) staat — moet exact gelijk zijn.
INGEST_TOKEN=verander-dit-ingest-geheim

# Welke groepen doorsturen? Komma-gescheiden stukjes van groepsnamen (hoofdletter-
# ongevoelig). Laat leeg om ALLE groepen door te sturen.
# Voorbeeld: GROUP_FILTER=DRS,Spoed
GROUP_FILTER=

# Ook 1-op-1 (privé) berichten doorsturen? true/false
FORWARD_DIRECT=true

# Map waar de WhatsApp-sessie wordt bewaard (zodat je niet elke keer opnieuw
# hoeft te scannen). Laat standaard staan.
SESSION_DIR=./wa-session

# Koppelen via 8-cijferige CODE i.p.v. QR-scannen (makkelijker).
# Vul hier het telefoonnummer in van het nummer dat je koppelt, internationaal
# en alleen cijfers (bv. 31612345678 voor 06-12345678). Laat leeg voor QR.
PAIR_NUMBER=

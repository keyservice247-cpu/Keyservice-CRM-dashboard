# --- Algemeen ---
# Poort waarop het dashboard draait
PORT=3000
# Geheime sleutel voor sessies/cookies (verander dit naar iets willekeurigs!)
SESSION_SECRET=verander-dit-in-iets-willekeurigs

# --- Inkomende koppelingen (webhooks) ---
# Gedeeld geheim dat e-mail/WhatsApp-koppelingen moeten meesturen om berichten af te leveren.
# Verander dit en gebruik dezelfde waarde in je koppeling (zie docs/INTEGRATIES.md).
INGEST_TOKEN=verander-dit-ingest-geheim

# --- AI-categorisatie ---
# Laat leeg om in DEMO-modus te draaien (categorisatie op basis van regels/keywords).
# Vul een Claude API-sleutel in (https://console.anthropic.com) om de echte AI te gebruiken.
ANTHROPIC_API_KEY=
# Model dat gebruikt wordt voor categorisatie
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Berichten met een AI-zekerheid >= deze drempel mogen automatisch worden goedgekeurd (0 = altijd handmatig controleren)
AI_AUTO_APPROVE_THRESHOLD=0

# --- E-mail koppeling (IMAP, bijv. TransIP) ---
# Laat IMAP_HOST leeg om de e-mailkoppeling uit te zetten.
# Voor TransIP is de server meestal imap.transip.email (controleer in je webmail-instellingen).
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# Hoe vaak (in seconden) de mailbox gecontroleerd wordt op nieuwe e-mail (minimaal 20).
IMAP_POLL_SECONDS=60

# --- WhatsApp Cloud API (officieel, van Meta) ---
# Dit token verzin je zelf en vul je ook in bij Meta wanneer je de webhook instelt.
WHATSAPP_VERIFY_TOKEN=verander-dit-whatsapp-verify-token
